    "test_start": "2011-09-01",
    "test_end": "2011-09-30"
  },
  "training": {
    "epochs": 30,
    "batch_size": 64,
    "learning_rate": 0.001,
    "seed": 42,
    "device": "cpu"
  },
  "models": {
    "lstm": {
      "hidden_size": 16,
      "embedding_size": 4
    },
    "transformer": {
      "d_model": 16,
      "nhead": 2,
      "embedding_size": 4
    }
  }
}